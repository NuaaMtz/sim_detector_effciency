########################################
# 先设置几何参数（必须带单位）
/mydet/detectorRadius 20 cm
/mydet/sourceDetectorDistance 1 m


/run/initialize
########################################
# 修改粒子源
/mydet/setSource Cs137

########################################
# 设置事件数，开始运行
/run/beamOn 1000000
########################################